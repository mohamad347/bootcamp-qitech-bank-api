{
    "title": "PostClient",
    "oneOf": [
        {
            "type": "object",
            "properties": {
                "client_type": {
                    "type": "string",
                    "enum": [
                        "INDIVIDUAL"
                    ]
                },
                "email": {
                    "type": "string",
                    "maxLength": 254,
                    "pattern": "^\\s*[^@\\s]+@[^@\\s]+\\.[^@\\s]+\\s*$"
                },
                "cpf": {
                    "type": "string",
                    "pattern": "^(\\d{11}|\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2})$"
                },
                "full_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                },
                "birth_date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "timezone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                }
            },
            "required": [
                "client_type",
                "email",
                "cpf",
                "full_name",
                "birth_date",
                "timezone"
            ],
            "additionalProperties": false
        },
        {
            "type": "object",
            "properties": {
                "client_type": {
                    "type": "string",
                    "enum": [
                        "COMPANY"
                    ]
                },
                "email": {
                    "type": "string",
                    "maxLength": 254,
                    "pattern": "^\\s*[^@\\s]+@[^@\\s]+\\.[^@\\s]+\\s*$"
                },
                "cnpj": {
                    "type": "string",
                    "pattern": "^(\\d{14}|\\d{2}\\.\\d{3}\\.\\d{3}/\\d{4}-\\d{2})$"
                },
                "legal_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                },
                "trade_name": {
                    "type": "string",
                    "maxLength": 200
                },
                "timezone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                }
            },
            "required": [
                "client_type",
                "email",
                "cnpj",
                "legal_name",
                "timezone"
            ],
            "additionalProperties": false
        }
    ]
}

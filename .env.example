# Configuração opcional — Bootcamp QI Tech
#
# O quick start NÃO exige copiar este arquivo. O docker-compose.yml possui
# defaults locais seguros para demonstração. Crie um .env apenas quando
# precisar sobrescrever portas, token ou integração externa:
#
#   cp .env.example .env
#
# Nunca coloque credenciais reais neste arquivo versionado.

# Aplicação principal
APP_ENV=local
SERVICE_NAME=bootcamp-api
INTERNAL_TOKEN=default_token
API_PORT=3000

# Timeouts PostgreSQL
DB_CONNECT_TIMEOUT_SECONDS=5
DB_LOCK_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000

# DATABASE_URL é útil apenas ao executar a aplicação diretamente no host.
# No Compose, a API principal usa db:5432 e a API de teste usa seu banco
# isolado por service name.
DATABASE_URL=postgresql+psycopg2://bootcamp:bootcamp@127.0.0.1:5432/bootcamp

# Analysis Provider da API principal. O default do Compose é o serviço
# mockserver, já inicializado com APPROVE e REJECT determinísticos.
ANALYSIS_PROVIDER_URL=http://mockserver:1080
ANALYSIS_PROVIDER_TIMEOUT=5
MOCKSERVER_LOG_LEVEL=WARN

# Connector de boletos
BANKSLIP_API_URL=http://localhost:8080
BANKSLIP_API_INTERNAL_TOKEN=default_token
BANKSLIP_API_TIMEOUT=5

# Infraestrutura isolada do pytest no host. Estes são os defaults já usados
# por tests/conftest.py; normalmente não é necessário defini-los.
SERVER_LOCALHOST=127.0.0.1
API_TEST_PORT=3001
API_TEST_DB_PORT=55433
SCHEMA_TEST_DB_PORT=55432
MOCKSERVER_TEST_PORT=1081
TEST_DATABASE_URL=postgresql+psycopg2://bootcamp:bootcamp@127.0.0.1:55432/bootcamp_test
MOCKSERVER_URL=http://127.0.0.1:1081

# Override interno avançado do Compose para a API de teste.
ANALYSIS_PROVIDER_TEST_URL=http://mockserver_test:1080
